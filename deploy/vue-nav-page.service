[Unit]
Description=Vue Nav Page static HTTP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/vue-nav-page
ExecStart=/srv/vue-nav-page/nav-server -host 0.0.0.0 -port 21000
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
